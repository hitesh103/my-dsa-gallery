# Cloudflare R2 (S3-compatible) credentials for listing/presigning
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="your-bucket-name"

# Optional: if your bucket is public (or fronted by a public domain),
# use this to avoid presigning GETs when listing.
R2_PUBLIC_BASE_URL="https://your-public-domain"

# Optional override for the R2 S3 endpoint
# R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"

# Optional: enable "Edit on GitHub" links on problem pages
# Example: hitesh103/my-dsa-gallery
NEXT_PUBLIC_GITHUB_REPO="yourname/yourrepo"
NEXT_PUBLIC_GITHUB_BRANCH="main"

# Admin token for in-app editing + image deletion (server-side only).
# Set this as a secret in Cloudflare Pages/Workers env.
ADMIN_TOKEN="change-me"

# ── R2 CORS ─────────────────────────────────────────────────────────────────
# The R2 bucket needs CORS configured for direct browser uploads via
# pre-signed URLs.  After deploying, log in as admin and run:
#
#   fetch("/api/admin/configure-cors", { method: "POST" })
#
# Or set it manually in the Cloudflare Dashboard:
#   R2 → my-dsa-hub-images → Settings → CORS → paste:
#
#   [
#     {
#       "AllowedOrigins": ["http://localhost:3000", "https://your-domain.workers.dev"],
#       "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
#       "AllowedHeaders": ["*"],
#       "ExposeHeaders": ["ETag"],
#       "MaxAgeSeconds": 3600
#     }
#   ]
#
